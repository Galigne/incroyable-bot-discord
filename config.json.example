{
  "locale": "Required. Bot language: use exactly \"en\" for English or \"fr\" for French.",
  "botUserId": "Required. The Discord user ID of this bot application.",
  "roles": {
    "dm": "Required. The Discord role ID for game masters who may generate content and manage any character.",

{
  "locale": "Required. Bot language: use exactly \"en\" for English or \"fr\" for French.",
  "botUserId": "Required. The Discord user ID of this bot application.",
  "roles": {
    "dm": "Optional. Discord role ID granting game-master permissions. Remove this field to make those actions server-owner-only; remove the entire roles object when neither role is configured.",
    "moderator": "Optional. Discord role ID granting moderator permissions. Remove this field to make those actions server-owner-only; remove the entire roles object when neither role is configured."
  },
  "channels": {
    "teamVoice": "Optional. The Discord voice channel ID that triggers local audio playback. Remove this field, or the entire channels object, to disable the trigger."
  },
  "characterHistory": {
    "maxEntries": "Optional. Positive whole-number limit for retained pre-change snapshots per character. Defaults to 3 when omitted; changes take effect for later history operations after /reload."
  }
}

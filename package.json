{
  "name": "incredible-discord-bot",
  "version": "1.0.2",
  "repository": "https://github.com/Galigne/incroyable-bot-discord.git",
  "description": "A Discord bot with moderation, utility, and RPG commands",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "format": "npm run format:js && npm run format:json",
    "format:js": "eslint . --fix",
    "format:json": "prettier --write --ignore-path .prettierignore \"**/*.json\"",
    "format:check": "npm run lint && npm run format:json:check",
    "format:json:check": "prettier --check --ignore-path .prettierignore \"**/*.json\"",
    "test:dice": "node --test scripts/dice.test.js",
    "test:deletion": "node --test scripts/characterDeletion.test.js",
    "test:editor": "node --test scripts/characterEditor.test.js",
    "test:creature-generation": "node --test scripts/creatureGeneration.test.js",
    "test:entities": "node --test scripts/entityManagement.test.js",
    "test:embeds": "node --test scripts/embedFooters.test.js",
    "test:generators": "node --test scripts/generatorCatalog.test.js scripts/generatorResolver.test.js scripts/generatorProductionIntegrity.test.js",
    "test:help": "node --test scripts/help.test.js",
    "test:history": "node --test scripts/characterHistory.test.js",
    "test:mechanics": "node --test scripts/mechanics.test.js",
    "test:optional-roles": "node --test scripts/optionalRoles.test.js",
    "test:registration": "node --test scripts/commandRegistration.test.js",
    "test:reload": "node --test scripts/reload.test.js",
    "test:runtime-robustness": "node --test scripts/runtimeRobustness.test.js",
    "test:registry": "node --test scripts/registry.test.js",
    "test:save-schema": "node --test scripts/characterSaveSchema.test.js",
    "test:responses": "node --test scripts/characterResponses.test.js",
    "test:persistence": "node --test scripts/characterPersistence.test.js",
    "test:services": "node --test scripts/services.test.js",
    "test": "npm run format:check && npm run test:dice && npm run test:deletion && npm run test:editor && npm run test:creature-generation && npm run test:embeds && npm run test:entities && npm run test:generators && npm run test:help && npm run test:history && npm run test:mechanics && npm run test:optional-roles && npm run test:registration && npm run test:reload && npm run test:runtime-robustness && npm run test:registry && npm run test:save-schema && npm run test:responses && npm run test:persistence && npm run test:services && npm run check"
  },
  "keywords": [
    "discord",
    "bot"
  ],
  "author": "Brox",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "5.3.0",
    "opusscript": "^0.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6"
  }
}

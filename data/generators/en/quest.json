{
  "schemaVersion": 2,
  "id": "quest",
  "kind": "template",
  "visibility": "public",
  "name": "quest",
  "description": "Adventure hooks, objectives, and dilemmas",
  "entrySchema": {
    "type": "template"
  },
  "entries": [
    {
      "id": "recover-item-before-criminal",
      "template": "Recover the item known as {{item}} from {{site}} before someone with the {{rival}} background takes it.",
      "references": {
        "item": {
          "generator": "inventory",
          "select": "display"
        },
        "site": {
          "generator": "dungeon",
          "select": "display"
        },
        "rival": {
          "generator": "background",
          "entry": "criminal",
          "select": "display"
        }
      }
    },
    {
      "id": "hunt-modified-monster",
      "template": "Hunt a creature identified as {{creature}} after witnesses associate it with the trait {{variation}}.",
      "references": {
        "creature": {
          "generator": "creature-monster",
          "select": "display"
        },
        "variation": {
          "generator": "modifier",
          "select": "display"
        }
      }
    },
    {
      "id": "defend-settlement-from-faction",

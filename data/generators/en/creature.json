{
  "schemaVersion": 3,
  "id": "creature",
  "visibility": "public",
  "name": "creature",
  "description": "Creature categories available for generation",
  "entrySchema": {
    "type": "fields",
    "required": ["name", "description", "generator"],
    "technical": ["generator"]
  },
  "entries": [
    {
      "id": "animal",
      "fields": {
        "name": "animal",
        "description": "Ordinary and fantastic friendly wildlife",
        "generator": "{{ creature_animal }}"
      }
    },
    {
      "id": "companion",
      "fields": {
        "name": "companion",
        "description": "Pets, familiars, and small traveling creatures",
        "generator": "{{ creature_companion }}"
      }
    },
    {
      "id": "monster",
      "fields": {
        "name": "monster",
        "description": "Hostile creatures and supernatural predators",
        "generator": "{{ creature_monster }}"
      }
    }
  ]
}

{
  "schemaVersion": 2,
  "id": "quest",
  "kind": "template",
  "visibility": "public",
  "name": "Quêtes",
  "description": "Amorces d’aventure, objectifs et dilemmes",
  "entrySchema": {
    "type": "template"
  },
  "entries": [
    {
      "id": "recover-item-before-criminal",
      "template": "Retrouver l’objet appelé {{item}} dans {{site}} avant qu’une personne au profil {{rival}} ne s’en empare.",
      "references": {
        "item": {
          "generator": "inventory",
          "select": "display"
        },
        "site": {
          "generator": "dungeon",
          "select": "display"
        },
        "rival": {
          "generator": "background",
          "entry": "criminal",
          "select": "display"
        }
      }
    },
    {
      "id": "hunt-modified-monster",
      "template": "Traquer une créature identifiée comme {{creature}} après que des témoins lui ont associé le qualificatif {{variation}}.",
      "references": {
        "creature": {
          "generator": "creature-monster",
          "select": "display"
        },
        "variation": {
          "generator": "modifier",
          "select": "display"
        }
      }
    },
    {
